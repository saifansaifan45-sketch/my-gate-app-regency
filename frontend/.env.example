# ==============================================================================
# Regency Salma - Frontend Environment Variables
# ==============================================================================

# The absolute URL to the backend API.
# 
# Usage guidelines:
# 1. Local Web Development:
#    EXPO_PUBLIC_API_URL=http://localhost:3000
# 
# 2. Physical Device Testing (iOS/Android via Expo Go):
#    Set this to your machine's LAN IP address. 
#    Example: EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
#    (Do not commit your personal LAN IP to version control)
#
# 3. Production:
#    Must be a secure HTTPS endpoint.
#    Example: EXPO_PUBLIC_API_URL=https://api.regencysalma.com
EXPO_PUBLIC_API_URL=http://localhost:3000
